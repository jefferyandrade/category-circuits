{
 "version": 1,
 "workspace_root": ".",
 "note": "Where the paper's circuits are. The results folders that hold circuits start with $CAMPAIGN, the circuit library's root; point it at your copy of the library. Paths in inputs are relative to this file's folder. For each network, pruning method (arm) and set of circuits (price), a run names its results folder (results_root), the folder of each category's circuit (arm_folder) and the categories it covers (cohort, which a method or a network can also set). A null folder or receipt field is not available. price v66 is the paper's circuits, at each network's loss threshold (Table 1); v64 and v65 are earlier extractions. The repeat extractions on the shared 100 categories are AlexNet's P-redraw arm and the retest run of P in VGG-11, ResNet-18 and ResNet-50 V2 (retest_pairs names each network's pair). The P circuits of VGG-11 and ResNet-50 and the SA-H circuits of VGG-11 and ResNet-18 cover the shared 100 categories.",
 "inputs": {
  "taxonomy": "inputs/category_taxonomy.csv",
  "shared_categories": "inputs/shared100.txt",
  "sign_per_category": "compact/results/sign_density_test/per_category_sign_density.csv",
  "hitrej_per_category": "inputs/hitrej_per_category.csv",
  "kv_routes": null,
  "s2as_lenses": null
 },
 "receipt_fields": {
  "native_density": "retained_fraction",
  "kernel_unit_density": null,
  "corrected_accuracy_drop": {
   "difference": [
    "terminal_dense_bce.class_balanced_binary_accuracy",
    "terminal_final_bce.class_balanced_binary_accuracy"
   ],
   "scale": 200
  },
  "heldout_delta_bce": "terminal_bce_delta",
  "loss_window_share": null,
  "hit_loss": {
   "difference": [
    "terminal_dense_bce.terminal_statistics_v1.probability_0_5.tpr",
    "terminal_final_bce.terminal_statistics_v1.probability_0_5.tpr"
   ]
  },
  "rejection_loss": {
   "difference": [
    "terminal_final_bce.terminal_statistics_v1.probability_0_5.fpr",
    "terminal_dense_bce.terminal_statistics_v1.probability_0_5.fpr"
   ]
  }
